+
+/* Open-drain software I2C: drive LOW or release, never drive HIGH.
+ * Opt in with sweettouchbitbang=1 while diagnosing a GENI FIFO/GSI mismatch.
+ * GPIO6/7 belong to TLMM NORTH on sdmmagpie (not sm6150).
+ */
+static void
+touch_bb_line(unsigned pin, bool release)
+{
+	touch_gpio(pin, 0, 3, 0, !release, false);
+	delay(5);
+}
+
+static int
+touch_bb_clock(void)
+{
+	touch_bb_line(7, true);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (touch_rd(st.gpio, TOUCH_GPIO_IO(7)) & 1u) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+touch_bb_stop(void)
+{
+	touch_bb_line(7, false);
+	touch_bb_line(6, false);
+	int err = touch_bb_clock();
+	touch_bb_line(6, true);
+	return err;
+}
+
+static int
+touch_bb_start(void)
+{
+	touch_bb_line(6, true);
+	int err = touch_bb_clock();
+	if (err) return err;
+	if (!(touch_rd(st.gpio, TOUCH_GPIO_IO(6)) & 1u)) return EBUSY;
+	touch_bb_line(6, false);
+	touch_bb_line(7, false);
+	return 0;
+}
+
+static int
+touch_bb_write(uint8_t value)
+{
+	for (unsigned i = 0; i < 8; ++i) {
+		touch_bb_line(6, (value & 0x80u) != 0);
+		int err = touch_bb_clock();
+		if (err) return err;
+		touch_bb_line(7, false);
+		value <<= 1;
+	}
+	touch_bb_line(6, true);
+	int err = touch_bb_clock();
+	if (err) return err;
+	bool nack = (touch_rd(st.gpio, TOUCH_GPIO_IO(6)) & 1u) != 0;
+	touch_bb_line(7, false);
+	return nack ? ENXIO : 0;
+}
+
+static int
+touch_bb_read(uint8_t *value, bool last)
+{
+	*value = 0;
+	touch_bb_line(6, true);
+	for (unsigned i = 0; i < 8; ++i) {
+		int err = touch_bb_clock();
+		if (err) return err;
+		*value = (uint8_t)((*value << 1) |
+		    (touch_rd(st.gpio, TOUCH_GPIO_IO(6)) & 1u));
+		touch_bb_line(7, false);
+	}
+	touch_bb_line(6, last); /* NACK final byte, ACK all preceding bytes. */
+	int err = touch_bb_clock();
+	touch_bb_line(7, false);
+	touch_bb_line(6, true);
+	return err;
+}
+
+static int
+touch_bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	int err = touch_bb_start();
+	if (!err) err = touch_bb_write((uint8_t)((addr << 1) | (nr ? 1u : 0u)));
+	for (unsigned i = 0; !err && i < nt; ++i) err = touch_bb_write(tx[i]);
+	for (unsigned i = 0; !err && i < nr; ++i) err = touch_bb_read(&rx[i], i + 1 == nr);
+	if (err || !stretch) {
+		int stop_err = touch_bb_stop();
+		if (!err) err = stop_err;
+	}
+	return err;
 }
 
