+static int
+touch_sec_ts(void)
+{
+	uint32_t mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		x[i] = st.x[i];
+		y[i] = st.y[i];
+	}
+
+	int events = 0;
+	while (events++ < 16) {
+		uint8_t buf[SEC_TS_EVENT_BUFF_SIZE] = {0};
+		int err = touch_read(SEC_TS_I2C_ADDR, SEC_TS_READ_ONE_EVENT, false, buf, sizeof(buf));
+		if (err) {
+			return err;
+		}
+		if (buf[0] == 0 || buf[0] == 0xffu) {
+			break; /* Buffer empty */
+		}
+		uint8_t eid = buf[0] & 0x0fu;
+		if (eid == SEC_TS_COORDINATE_EVENT) {
+			uint8_t tid = (buf[0] >> 4) & 0x0fu;
+			uint8_t tchsta = eid;
+			if (tid < TOUCH_MAX) {
+				unsigned id = tid;
+				unsigned raw_x = (unsigned)buf[1] | (((unsigned)buf[2] & 0x0fu) << 8);
+				unsigned raw_y = ((unsigned)buf[2] >> 4) | ((unsigned)buf[3] << 4);
+				unsigned px = (raw_x * 1079u) / 4095u;
+				unsigned py = (raw_y * 2399u) / 4095u;
+				if (px > 1079u) px = 1079u;
+				if (py > 2399u) py = 2399u;
+
+				if (tchsta == SEC_TS_COORDINATE_ACTION_PRESS ||
+				    tchsta == SEC_TS_COORDINATE_ACTION_MOVE) {
+					mask |= (1u << id);
+					x[id] = (int)px;
+					y[id] = (int)py;
+				} else if (tchsta == SEC_TS_COORDINATE_ACTION_RELEASE) {
+					mask &= ~(1u << id);
+				}
+			}
+		} else if (eid == SEC_TS_STATUS_EVENT) {
+			uint8_t stype = (buf[0] >> 2) & 0x0fu;
+			if (stype == 1u) { /* ERR event */
+				const uint8_t cmd_clear = SEC_TS_CMD_CLEAR_EVENT_STACK;
+				(void)touch_msg(SEC_TS_I2C_ADDR, &cmd_clear, 1, NULL, 0, false);
+				mask = 0;
+			}
+		}
+		/* READ_ONE_EVENT returns one event; poll again while IRQ remains active. */
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
