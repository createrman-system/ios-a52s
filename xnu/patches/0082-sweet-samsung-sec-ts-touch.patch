+static void
+touch_power_dvdd(void)
+{
+	vm_offset_t core = ml_io_map(0x0c440000u, 0x2000);
+	vm_offset_t cnfg = ml_io_map(0x0c40a000u, 0x1000);
+	vm_offset_t obs  = ml_io_map(0x0e600000u, 0x10000);
+	if (!core || !cnfg || !obs) {
+		printf("SWEET TOUCH: SPMI map failed\n");
+		return;
+	}
+	uint32_t count = touch_rd(core, 4) & 0x7ffu;
+	uint16_t apid = 0xffffu;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = touch_rd(core, 0x900u + 4u * i);
+		if (((map >> 8) & 0xfffu) == 0x0c3u) {
+			uint32_t owner = touch_rd(cnfg, 0x700u + 4u * i) & 7u;
+			if (apid == 0xffffu || owner == 0) {
+				apid = (uint16_t)i;
+			}
+		}
+	}
+	if (apid == 0xffffu) {
+		printf("SWEET TOUCH: PM6150 GPIO4 APID not found\n");
+		return;
+	}
+	uint32_t obs_off = 0x80u * apid;
+	uint8_t en = 0, out = 0;
+	touch_wr(obs, obs_off, (1u << 27) | (0x46u << 4));
+	for (int j = 0; j < 500; j++) { if (touch_rd(obs, obs_off + 8) & 1u) { en = (uint8_t)touch_rd(obs, obs_off + 0x18); break; } delay(1); }
+	touch_wr(obs, obs_off, (1u << 27) | (0x45u << 4));
+	for (int j = 0; j < 500; j++) { if (touch_rd(obs, obs_off + 8) & 1u) { out = (uint8_t)touch_rd(obs, obs_off + 0x18); break; } delay(1); }
+	printf("SWEET TOUCH: PM6150 GPIO4 apid=%u init en=%#x out=%#x\n", apid, en, out);
+
+	vm_offset_t chnl = ml_io_map(0x0c600000u + 0x10000u * (vm_offset_t)apid, 0x1000);
+	if (chnl) {
+		touch_wr(chnl, 0x10, 1u);
+		touch_wr(chnl, 0x00, (0u << 27) | (0x45u << 4) | 0u);
+		for (int j = 0; j < 500; j++) { if (touch_rd(chnl, 8) & 1u) break; delay(1); }
+		touch_wr(chnl, 0x10, 1u);
+		touch_wr(chnl, 0x00, (0u << 27) | (0x40u << 4) | 0u);
+		for (int j = 0; j < 500; j++) { if (touch_rd(chnl, 8) & 1u) break; delay(1); }
+		touch_wr(chnl, 0x10, 0x80u);
+		touch_wr(chnl, 0x00, (0u << 27) | (0x46u << 4) | 0u);
+		for (int j = 0; j < 500; j++) { if (touch_rd(chnl, 8) & 1u) break; delay(1); }
+		touch_wr(obs, obs_off, (1u << 27) | (0x46u << 4));
+		for (int j = 0; j < 500; j++) { if (touch_rd(obs, obs_off + 8) & 1u) { en = (uint8_t)touch_rd(obs, obs_off + 0x18); break; } delay(1); }
+		touch_wr(obs, obs_off, (1u << 27) | (0x45u << 4));
+		for (int j = 0; j < 500; j++) { if (touch_rd(obs, obs_off + 8) & 1u) { out = (uint8_t)touch_rd(obs, obs_off + 0x18); break; } delay(1); }
+		printf("SWEET TOUCH: PM6150 GPIO4 DVDD active en=%#x out=%#x\n", en, out);
+	}
+}
