+static int
+touch_sec_ts(void)
+{
+	uint32_t mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		x[i] = st.x[i];
+		y[i] = st.y[i];
+	}
+
+	int events = 0;
+	while (events++ < 16) {
+		uint8_t buf[SEC_TS_EVENT_BUFF_SIZE] = {0};
+		int err = touch_read(SEC_TS_I2C_ADDR, SEC_TS_READ_ONE_EVENT, false, buf, sizeof(buf));
+		if (err) {
+			return err;
+		}
+		if (buf[0] == 0 || (buf[0] & 3u) == 3u) {
+			break; /* Buffer empty or empty event */
+		}
+		uint8_t eid = buf[0] & 3u;
+		if (eid == SEC_TS_COORDINATE_EVENT) {
+			uint8_t tid = (buf[0] >> 2) & 0x0fu;
+			uint8_t tchsta = (buf[0] >> 6) & 0x03u;
+			if (tid >= 1 && tid <= TOUCH_MAX) {
+				unsigned id = tid - 1u;
+				unsigned px = ((unsigned)buf[1] << 4) | ((buf[3] >> 4) & 0x0fu);
+				unsigned py = ((unsigned)buf[2] << 4) | (buf[3] & 0x0fu);
+				if (px <= 1079 && py <= 2399) {
+					if (tchsta == SEC_TS_COORDINATE_ACTION_PRESS ||
+					    tchsta == SEC_TS_COORDINATE_ACTION_MOVE) {
+						mask |= (1u << id);
+						x[id] = (int)px;
+						y[id] = (int)py;
+					} else if (tchsta == SEC_TS_COORDINATE_ACTION_RELEASE) {
+						mask &= ~(1u << id);
+					}
+				}
+			}
+		} else if (eid == SEC_TS_STATUS_EVENT) {
+			uint8_t stype = (buf[0] >> 2) & 0x0fu;
+			if (stype == 1u) { /* ERR event: clear event stack */
+				const uint8_t cmd_clear = SEC_TS_CMD_CLEAR_EVENT_STACK;
+				(void)touch_msg(SEC_TS_I2C_ADDR, &cmd_clear, 1, NULL, 0, false);
+				mask = 0;
+			}
+		}
+		uint8_t left = buf[7] & 0x1fu;
+		if (left == 0) {
+			break;
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
