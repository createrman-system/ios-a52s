+static void
+touch_gpio_west(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	if (!st.gpio_west) {
+		return;
+	}
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio_west, off);
+	if (out) {
+		touch_wr(st.gpio_west, TOUCH_GPIO_IO(pin),
+		    (touch_rd(st.gpio_west, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio_west, off, cfg);
+}
