diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -172,10 +172,15 @@
 AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 {
 	AppleCLCD *fb = (AppleCLCD *)owner;
+	if (fb->fVsyncCount == 0) {
+		IOLog("SWEET TRACE: AppleCLCD first vsync callback entered\n");
+	}
 	if (!fb->fRegistered) {
 		fb->fRegistered = true;
 		IOLog("SWEET FB: deferred registerService\n");
+		IOLog("SWEET TRACE: AppleCLCD deferred registerService begin\n");
 		fb->registerService();
+		IOLog("SWEET TRACE: AppleCLCD deferred registerService returned\n");
 	}
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
@@ -193,6 +198,9 @@
 	}
 	IOLockUnlock(fb->fLock);
 	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+	if (count == 1) {
+		IOLog("SWEET TRACE: AppleCLCD first vsync callback completed\n");
+	}
 }
 
