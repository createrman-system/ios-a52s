+/* PM6150 GPIO4 is peripheral 0xc3 on SID0. REG_DIG_OUT_CTL (0x45)
+ * controls drive strength, not output value. Match pinctrl-spmi-gpio.c:
+ * LV/MV output value is 0x44 bit7 and direction is 0x40 bits1:0.
+ */
+static bool
+touch_dvdd_read(vm_offset_t obs, uint32_t lane, uint8_t reg, uint8_t *value)
+{
+	touch_wr(obs, lane, (1u << 27) | ((uint32_t)reg << 4));
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = touch_rd(obs, lane + 8);
+		if (status & 1u) {
+			if (status & 0xeu) return false;
+			*value = (uint8_t)touch_rd(obs, lane + 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+touch_dvdd_write(vm_offset_t channel, uint8_t reg, uint8_t value)
+{
+	touch_wr(channel, 0x10, value);
+	touch_wr(channel, 0, (uint32_t)reg << 4);
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = touch_rd(channel, 8);
+		if (status & 1u) return !(status & 0xeu);
+		delay(1);
+	}
+	return false;
+}
+
